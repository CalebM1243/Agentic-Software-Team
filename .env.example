# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model every agent uses (default: claude-opus-5-5).
# SWARM_MODEL=claude-sonnet-5-5

# Optional: reasoning effort, one of low|medium|high|xhigh|max (default: high).
# Leave it empty for models that don't support effort, such as claude-haiku-4-5.
# SWARM_EFFORT=medium

# Optional: failed Developer/QA rounds before escalating to you (default: 3).
# MAX_DEV_ROUNDS=3
